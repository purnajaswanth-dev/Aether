# ==============================================================================
# Aether Production Environment Configuration Template
# Copy this file to .env and replace all placeholders with actual values.
# NEVER commit .env to source control!
# ==============================================================================

# ------------------------------------------------------------------------------
# Production Database (Neon PostgreSQL)
# ------------------------------------------------------------------------------
# Shared JDBC Connection URL (Must include sslmode=require for TLS)
# Example: jdbc:postgresql://ep-xyz.us-east-2.aws.neon.tech:5432/neondb?sslmode=require
# Or pooled: jdbc:postgresql://ep-xyz-pooler.us-east-2.aws.neon.tech:5432/neondb?sslmode=require
DB_URL=jdbc:postgresql://<NEON_HOST>:5432/<NEON_DATABASE>?sslmode=require

# Runtime Identity (Unprivileged application role with NOBYPASSRLS for Spring Boot)
DB_USERNAME=aether_app
DB_PASSWORD=replace_with_aether_app_runtime_password

# Migration Identity (Privileged database owner role for Flyway schema DDL)
MIGRATION_DB_USERNAME=neondb_owner
MIGRATION_DB_PASSWORD=replace_with_neondb_owner_password

# ------------------------------------------------------------------------------
# Local Docker Database (Used for local development only)
# ------------------------------------------------------------------------------
POSTGRES_DB=aether
POSTGRES_USER=aether
POSTGRES_PASSWORD=aether_dev_password

# ------------------------------------------------------------------------------
# Application Security
# ------------------------------------------------------------------------------
# Generate a 256-bit (64 hex characters) secret for JWT signing:
# Command: openssl rand -hex 32
AETHER_JWT_SECRET=replace_with_hex_encoded_256_bit_jwt_secret_key_minimum_64_chars

# Master Key for encrypting integration credentials and webhook secrets:
# Command: openssl rand -hex 32
AETHER_MASTER_KEY=replace_with_hex_encoded_256_bit_master_encryption_key

# ------------------------------------------------------------------------------
# Web Server Port
# ------------------------------------------------------------------------------
PORT=8080
